# ============================================
# Downloaded data (see data/download_data.sh)
# ============================================
# Keep scripts and documentation
!data/download_data.sh
!data/README.md

# Keep bundled auxiliary files (not from GEO, required for regeneration)
!data/GSE291468/scBridge_predictions/
!data/GSE291468/Seurat_cluster_barcodes/
!data/GSE291468/extract_cluster_barcodes.R

# ============================================
# PQS/PQSfinder (shipped with repo)
# ============================================
# PQS predictions are computed by authors and shipped with repo (not from GEO)
# The filter script generates min40/min50 subsets on demand
!data/pqsfinder/PQS_scores.mm10.bed
!data/pqsfinder/PQS_scores.mm10.bw
!data/pqsfinder/filter_pqs.sh
!data/pqsfinder/pqs_mm10.R
# Filtered subsets (can be regenerated with filter_pqs.sh)
data/pqsfinder/PQS_scores.min*.bed

# ============================================
# GSE291468 - Primary scG4 CUT&Tag data
# ============================================
# Ignore all downloaded files
data/GSE291468/*.bw
data/GSE291468/*.bam
data/GSE291468/*.bam.bai
data/GSE291468/*.Rds
data/GSE291468/*.narrowPeak
data/GSE291468/*.narrowPeak.gz
data/GSE291468/*.broadPeak
data/GSE291468/*.broadPeak.gz
data/GSE291468/GSM*/

# EXCEPTION: Regenerated GSM8836086 bigwigs (shipped with repo)
# These replace GEO originals with corrected versions (duplicates removed, correct effective genome size)
!data/GSE291468/GSM8836086_Predicted_Astrocytes_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_non-Astrocytes_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Oligodendrocyte_progenitor_cells_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Committed_and_Newly_formed_oligodendr_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Mature_oligodendrocytes_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Olfactory_ensheathing_cells_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Pericytes_RPGC.bw
!data/GSE291468/GSM8836086_Predicted_Vascular_endothelial_cells_RPGC.bw
!data/GSE291468/GSM8836086_Unreliable_predictions_RPGC.bw

# Smoothed variants are too large to sync; regenerate via regenerate_bigwigs.sh
data/GSE291468/*.smooth150.bw

