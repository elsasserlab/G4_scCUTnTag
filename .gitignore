# ============================================
# Downloaded data (see data/download_data.sh)
# ============================================
# Keep scripts and documentation
!data/download_data.sh
!data/README.md

# Keep bundled auxiliary files (not from GEO, required for regeneration)
!data/GSE291468/scBridge_predictions/
!data/GSE291468/Seurat_cluster_barcodes/
!data/GSE291468/extract_cluster_barcodes.R

# ============================================
# PQS/PQSfinder (large files come from the Zenodo release)
# ============================================
# PQS predictions were computed by the authors (not from GEO). The two
# large files (PQS_scores.mm10.bed / .bw) ship with the Zenodo release
# and are extracted into data/ by data/download_data.sh; they are not
# tracked in git. The filter script generates min40/min50 subsets on demand
!data/pqsfinder/filter_pqs.sh
!data/pqsfinder/pqs_mm10.R
data/pqsfinder/PQS_scores.mm10.bed
data/pqsfinder/PQS_scores.mm10.bw
# Filtered subsets (can be regenerated with filter_pqs.sh)
data/pqsfinder/PQS_scores.min*.bed

# ============================================
# GSE291468 - Primary scG4 CUT&Tag data
# ============================================
# Ignore all downloaded files
data/GSE291468/*.bw
data/GSE291468/*.bam
data/GSE291468/*.bam.bai
data/GSE291468/*.Rds
data/GSE291468/*.narrowPeak
data/GSE291468/*.narrowPeak.gz
data/GSE291468/*.broadPeak
data/GSE291468/*.broadPeak.gz

# Cell Ranger outputs per GSM (large; fragments.tsv.gz is downloaded from GEO).
# peaks.bed / singlecell.csv / raw peak matrices / QC files are NOT published
# on GEO for every sample - the files we ship with the repo are negated below.
data/GSE291468/GSM*/CellRanger/fragments.tsv.gz
data/GSE291468/GSM*/CellRanger/peak_annotation.tsv
data/GSE291468/GSM*/CellRanger/peak_motif_mapping.bed
data/GSE291468/GSM*/CellRanger/*.h5
data/GSE291468/GSM*/CellRanger/summary.csv
data/GSE291468/GSM*/CellRanger/web_summary.html
data/GSE291468/GSM*/CellRanger/singlecell.csv
data/GSE291468/GSM*/CellRanger/peaks.bed

# EXCEPTION: shipped Cell Ranger files that GEO does not publish.
# peaks.bed (GSM8836086) is required by fig4/fig4.R and rev_F30;
# singlecell.csv (GSM8836088) is required by fig1/seurat_workflow.R reruns.
!data/GSE291468/GSM8836086_GFP_sorted_mouse_brain/CellRanger/peaks.bed
!data/GSE291468/GSM8836088_mESC_MEF/CellRanger/singlecell.csv

# Regenerated GSM8836086 bigwigs (shipped via the Zenodo release).
# These replace GEO originals with corrected versions (duplicates removed,
# correct effective genome size) and are extracted into data/ by
# data/download_data.sh.
# Smoothed variants are regenerated via regenerate_bigwigs.sh or come
# from the Zenodo release as well.

# ============================================
# Other GSE series - Downloaded from GEO
# ============================================
data/GSE163484/*.csv.gz
# Author-provided Bartosovic reference Seurat object comes from the
# Zenodo release (extracted by data/download_data.sh)
data/GSE163484/*.Rds
# Author-provided Zeisel neuron Seurat object comes from the Zenodo release
data/Zeisel2018/*.Rds
data/GSE198467/*.Rds
data/GSE198467/*.tsv.gz
data/GSE198467/*.tsv.gz.tbi
data/GSE198467/macs2_out/
# Author-provided RPGC bigWig for GSE198467 comes from the Zenodo release
data/GSE198467/*.bw
# Consensus peaks are regenerated by GSE198467/reprocess_atac_peaks.sh,
# but we ship the author's version so rev_F28/rev_F30 work out of the box
data/GSE198467/*.narrowPeak
!data/GSE198467/GSE198467_atac_consensus_peaks.narrowPeak
# Bulk ATAC bigWigs + peaks: shipped as-is (author-reprocessed mm10 versions,
# not regenerable from GEO - GSE149080 publishes mm9 only, no peak calls).
# The bigWigs come from the Zenodo release; the narrowPeaks ship with git.
data/GSE149080/*.bw
data/GSE149080/*.narrowPeak
!data/GSE149080/GSM4661960_ESC_WT_batch2_peaks.narrowPeak
data/GSE211123/*.bw
data/GSE211123/*.narrowPeak
!data/GSE211123/GSM6451000_3T3_control_ATAC_peaks.narrowPeak
data/GSE217860/*.bw
data/GSE90894/*.xlsx

